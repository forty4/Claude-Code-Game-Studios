theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 14
mouse_filter = 2

[node name="Spacer2" type="Control" parent="Center/Box"]
custom_minimum_size = Vector2(0, 16)
mouse_filter = 2

[node name="Footer" type="HBoxContainer" parent="Center/Box"]
alignment = 1
theme_override_constants/separation = 12
mouse_filter = 2

[node name="BackButton" type="Button" parent="Center/Box/Footer"]
