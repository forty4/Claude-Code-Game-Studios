; Chapter 1 (장판파 / Changbanpo) production-tier visual scene.
; Authored per ADR-0021 §1 + §2 — mounted at /root by SceneManager.
;
; Tile rendering: chapter_visuals.gd `_draw()` overrides on the root Node2D.
; Unit silhouettes: spawned at runtime by BattleScene._spawn_unit_polygons_async
; → ChapterVisuals.spawn_unit_polygons(roster) so deployment branch overrides
; render correctly. PlayerUnits/EnemyUnits are kept here as empty container
; nodes; the spawn helper clears+repopulates them on every battle start.
;
; TILE_SIZE = 64 (matches chapter_visuals.gd TILE_SIZE = BalanceConstants.TILE_WORLD_SIZE).
; Unit position formula: (col * 64 + 32, row * 64 + 32) — center of tile.
;
; Faction colors per art-bible §4.2 (촉 #2e5f7a / 위 #4a4a4a) applied at spawn time.
; Reserved colors 주홍 #c0392b + 금색 #d4a017 are NOT used for units per
; art-bible §1.지지 원칙 2 + §4.1 절대 금지.

[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/feature/battle_scene/chapter_visuals.gd" id="1_chapter"]
[ext_resource type="Resource" path="res://assets/data/maps/mvp_chapter_01.tres" id="2_map"]

[node name="ChapterVisuals" type="Node2D"]
script = ExtResource("1_chapter")
map_resource = ExtResource("2_map")

[node name="PlayerUnits" type="Node2D" parent="."]

[node name="EnemyUnits" type="Node2D" parent="."]
