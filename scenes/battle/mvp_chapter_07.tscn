; Chapter 7 (장판교 / Changban Bridge) production-tier visual scene.
; Authored per ADR-0021 §1 + §2 — mounted at /root by SceneManager.
;
; Tile rendering: chapter_visuals.gd `_draw()` overrides on the root Node2D.
; Unit silhouettes: spawned at runtime by BattleScene._spawn_unit_polygons_async
; → ChapterVisuals.spawn_unit_polygons(roster). PlayerUnits/EnemyUnits are kept
; as empty container nodes; the spawn helper clears+repopulates them.
;
; TILE_SIZE = 64. Unit position formula: (col * 64 + 32, row * 64 + 32).
;
; Branch wiring (per assets/data/scenarios/shu_canon_full.json branch_table):
;   - LOSS_changbanpo_retreat (default): no 유비 deployed; 장비 at [3,3] on bridge.
;   - WIN_changbanpo_default: 유비 at [2,3] BEHIND 장비 (heroic stand variant).
;
; Faction colors per art-bible §4.2 (촉 #2e5f7a / 위 #4a4a4a) applied at spawn time.

[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/feature/battle_scene/chapter_visuals.gd" id="1_chapter"]
[ext_resource type="Resource" path="res://assets/data/maps/mvp_chapter_07.tres" id="2_map"]

[node name="ChapterVisuals" type="Node2D"]
script = ExtResource("1_chapter")
map_resource = ExtResource("2_map")

[node name="PlayerUnits" type="Node2D" parent="."]

[node name="EnemyUnits" type="Node2D" parent="."]
