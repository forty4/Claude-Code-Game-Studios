[gd_scene format=3]

;; UI-GB-02 Action Menu — story-005 + S86 layout pass.
;; HBoxContainer root anchored to bottom-center per S86 ("ko.po + UI-GB-02
;; 강조" task) to fix HUD button discoverability — pre-S86 the menu lived
;; at (0,0) top-left and players never noticed it.
;; Buttons: MOVE / ATTACK / USE_SKILL / DEFEND / WAIT / END_TURN.
;; custom_minimum_size = Vector2(96, 56) — larger than the 44pt touch-target
;; floor so the 한글 button text (이동/공격/스킬/방어/대기/턴종료) reads
;; clearly. text = "" — set at runtime via tr() per i18n discipline
;; (forbidden_pattern battle_hud_hardcoded_localized_strings).

[node name="UI_GB_02_ActionMenu" type="HBoxContainer"]
tooltip_text = "Action menu"
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -310.0
offset_top = -110.0
offset_right = 310.0
offset_bottom = -54.0
grow_horizontal = 2
grow_vertical = 0
theme_override_constants/separation = 8

[node name="MoveButton" type="Button" parent="."]
tooltip_text = "Move action"
custom_minimum_size = Vector2(96, 56)
text = ""

[node name="AttackButton" type="Button" parent="."]
tooltip_text = "Attack action"
custom_minimum_size = Vector2(96, 56)
text = ""

[node name="UseSkillButton" type="Button" parent="."]
tooltip_text = "Use skill action"
custom_minimum_size = Vector2(96, 56)
text = ""

[node name="DefendButton" type="Button" parent="."]
tooltip_text = "Defend action"
custom_minimum_size = Vector2(96, 56)
text = ""

[node name="WaitButton" type="Button" parent="."]
tooltip_text = "Wait action"
custom_minimum_size = Vector2(96, 56)
text = ""

[node name="EndTurnButton" type="Button" parent="."]
tooltip_text = "End turn action"
custom_minimum_size = Vector2(96, 56)
text = ""
