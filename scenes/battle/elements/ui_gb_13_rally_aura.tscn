;;   - 3+ Commanders (15% cap) → 40% opacity
;;   - 2px logical dashed border (황금 80% opacity) for colorblind accessibility
;;     per pass-11c R-3 (battle-hud.md §3 UI-GB-13)
;;
;; Story-007 ADVISORY: GridBattleController.get_active_commanders() not yet
;; exposed — UI-GB-13 render gated via has_method() defensive fallback.
;; Real opacity scaling + dashed border deferred per ADVISORY in story-007 evidence.

[node name="UI_GB_13_RallyAura" type="Node2D"]
