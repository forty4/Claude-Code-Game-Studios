[ext_resource type="Script" path="res://src/core/map_tile_data.gd" id="2_tiledata"]

; mvp_chapter_08 — 강하 외곽 마지막 차단 (Xiakou Outskirts)
; 14 cols × 8 rows. River on right (col 13) is the escape edge; one bridge tile
; at [13,4] is the only way across. Mountain pass at col 4 (rows 2 + 5) forces the
; pursuit/defense traffic through [4,3] and [4,4] (the road tiles). Forest copses
; in NW/SW corners and on the east bank give optional cover.
;
; Terrain type ids per chapter_visuals._get_terrain_color:
;   0 PLAINS  1 FOREST  2 HILLS  3 MOUNTAIN  4 RIVER  5 BRIDGE  7 ROAD

