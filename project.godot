; Engine configuration file.
; Generated for Godot 4.6 — do NOT edit while the editor is open.
; Property paths verified against 4.6 godot-demo-projects.

config_version=5

[application]

config/name="천명역전"
config/description="Defying Destiny — Turn-based grid strategy RPG."
config/features=PackedStringArray("4.6")
; SPRINT-7+ TEMPORARY — battle_scene.tscn remains as main_scene until Main Menu /
; Overworld scenes ship (no revert target exists yet at sprint-7 close 2026-05-05).
; ADR-0017 acceptance via /architecture-review delta #12 retained the
; sprint-6 inline mock encoder DELETION (per S7-02 atomicity) but the
; main_scene flip cannot revert until a SceneManager-driven launch surface
; ships. Tracked as deviation in scenario_runner_3_chapter_mvp_2026-05-05.md.
; Main scene: 메인 메뉴 (이어하기 / 새 시나리오 / 종료). The previous direct boot
; into battle_scene.tscn is preserved as the test/smoke target — tests load it
; explicitly, and `godot --headless ... battle_scene.tscn` still works for
; debugging mid-battle issues without going through the menu.
run/main_scene="res://scenes/main_menu/main_menu.tscn"

[autoload]

; ORDER-SENSITIVE: GameBus must be first — all other autoloads may reference it in _ready
GameBus="*res://src/core/game_bus.gd"
SceneManager="*res://src/core/scene_manager.gd"
SaveManager="*res://src/core/save_manager.gd"
GameBusDiagnostics="*res://src/core/game_bus_diagnostics.gd"
BuildModeSentinel="*res://src/platform/build_mode_sentinel.gd"
; Boot order position 6: depends on GameBus (signal subscription) + SceneManager
; (scenario_fault dialog routing) + SaveManager (save_checkpoint_requested).
; ADR-0017 §Decision §Class Form. NO `class_name` per G-3 autoload rule.
ScenarioRunner="*res://src/core/scenario_runner.gd"
; Boot order position 7: depends on GameBus + ScenarioRunner (subscribes to
; scenario_beat_retried + chapter_completed) per CR-DS-9. NO `class_name` per G-3.
; ADR-0003 SaveContext + ADR-0017 ScenarioRunner + ADR-0018 DestinyBranch.
DestinyState="*res://src/feature/destiny_state/destiny_state.gd"
; Boot order position 8: depends on GameBus + ScenarioRunner + DestinyState
; (subscribes to chapter_started + destiny_branch_chosen + scenario_complete +
; chapter_completed) per CR-SE-6/7. NO `class_name` per G-3.
; ADR-0017 ScenarioRunner + ADR-0018 DestinyBranch + ADR-0001 GameBus (3 NEW
; signals require minor amendment per Evolution Rule #4 at /architecture-review).
StoryEvent="*res://src/feature/story_event/story_event.gd"
; Boot order position 9: depends on GameBus + SceneManager + SaveManager (the
; 3 foundational autoloads). Consumes ui_input_block_requested +
; ui_input_unblock_requested (story-007 wires subscriptions). Per ADR-0005 §1
; (form-level Autoload Node + 6 fields) + ADR-0020 §Decision §6 (boot pos 9
; per delta #15 footnote — supersedes ADR-0005 line 117 "load order 4" wording
; that reflected the project state at ADR-0005 acceptance time when only 3
; autoloads existed). class_name InputRouter is OMITTED per G-3 — Godot 4.6
; fires "Parse Error: Could not parse global class InputRouter" when both
; class_name and autoload registration are present (verified at S8-02
; implementation time 2026-05-06; ADR-0020 §Decision §6 footnote claim "G-3
; verification SETTLED — works" was speculative pre-implementation and is
; corrected here). Same pattern as GameBus/SceneManager/SaveManager/
; ScenarioRunner/DestinyState/StoryEvent — all autoloads omit class_name.
InputRouter="*res://src/foundation/input_router.gd"
; Boot order position 10: depends on GameBus only (subscribes to unit_died +
; chapter_completed for SFX cues). NO `class_name` per G-3 autoload rule.
; Procedural-only SFX layer; swap _build_procedural_streams for an asset
; loader when real audio under assets/audio/sfx/ ships.
SoundManager="*res://src/feature/audio/sound_manager.gd"

[display]

; Viewport set generously so the chapter-1 14×10 grid + HUD ribbon stay
; readable on a Mac desktop. Without this Godot defaults to 1152×648 which
; left the tiles too small to read names + chevrons during eyeball verification.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true

[input_devices.pointing]

; Story-008 verification #3 (ADR-0005 §Verification Required §3 + CR-2e + R-3):
; Touch events MUST NOT synthesize fake mouse events that double-fire actions
; via two dispatch paths. Story-010 wires a CI lint to enforce this.
emulate_mouse_from_touch=false

[physics]

; Jolt is the Godot 4.6 default for 3D — explicit per story AC.
; This is a 2D game; 3D physics engine selection has no runtime effect.
3d/physics_engine="Jolt Physics"

[rendering]

; Mobile renderer — per .claude/docs/technical-preferences.md.
; Do NOT override rendering backend per-platform here (trust engine defaults).
renderer/rendering_method="mobile"
